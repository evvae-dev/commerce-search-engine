# 개인 PC의 전용 데모 Elasticsearch와 SQLite 원본
ELASTICSEARCH_NODE=http://127.0.0.1:19200
ELASTICSEARCH_GOODS_INDEX=dev-search-goods
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000
DEMO_DB_PATH=.demo/catalog.sqlite

# setup 명령이 로컬 전용 비밀번호와 세션 비밀키를 생성한다.
DEMO_AUTH_ENABLED=true
DEMO_ADMIN_PASSWORD=
NEXTAUTH_URL=http://127.0.0.1:3200
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=example.test
CORS_ALLOW_ORIGIN=http://127.0.0.1:3200

# 선택 기능: 실제 임베딩 서버를 별도로 실행한 경우 활성화한다.
SEMANTIC_SEARCH_ENABLED=false
EMBEDDING_NODE=http://127.0.0.1:18080
EMBEDDING_MODEL_VERSION=intfloat/multilingual-e5-small:v1
EMBEDDING_BATCH_SIZE=128
EMBEDDING_REQUEST_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=2

# 선택 기능: 개인화 헤더 서명. setup 명령이 난수를 생성한다.
PERSONALIZATION_CONTEXT_SECRET=
PERSONALIZATION_CONTEXT_MAX_AGE_MS=300000
PERSONALIZATION_CACHE_MAX_ENTRIES=5000

# 선택 기능: 검색어 AI 확장. 키가 없으면 외부 API를 호출하지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SEARCH_LAB_API_KEY=

# 로컬 데모의 prd도 같은 가상 원본을 사용한다. 수동 실행만 허용한다.
INDEXING_PRD_MANUAL_ENABLED=true
INDEXING_PRD_INCREMENTAL_ENABLED=true
INDEX_ALIAS_MIN_GOODS_COUNT_RATIO=0.5
SEARCH_SETTINGS_CACHE_TTL_MS=30000
